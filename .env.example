# Copy to .env.local (git-ignored) or set as build env vars. Never commit real values.
# Lead endpoint: defaults to the shared SOD website lead endpoint; "off" = preview mode.
NEXT_PUBLIC_LEAD_ENDPOINT=https://erp.sodraqam.com/api/website-lead
# "demo" (default: endpoint returns { demos: { full, lite } }) or "contact" fallback
NEXT_PUBLIC_LEAD_DEMO_TYPE=demo
# Optional demo logins shown after submit (placeholders only in the repo)
NEXT_PUBLIC_DEMO_FULL_URL=
NEXT_PUBLIC_DEMO_FULL_USER=
NEXT_PUBLIC_DEMO_FULL_PASSWORD=
NEXT_PUBLIC_DEMO_LITE_URL=
NEXT_PUBLIC_DEMO_LITE_USER=
NEXT_PUBLIC_DEMO_LITE_PASSWORD=
# Optional
NEXT_PUBLIC_SITE_URL=https://sodeduplus.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
